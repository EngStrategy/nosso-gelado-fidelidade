# Porta e interface em que o servidor escuta
PORT=3000
HOST=127.0.0.1

# Chave secreta do JWT (troque por uma sequência aleatória longa, mín. 32 caracteres)
# No terminal do Ubuntu, você pode gerar uma com: openssl rand -base64 32
JWT_SECRET=coloque-uma-chave-secreta-muito-segura-e-longa-aqui-123456789

# Tempo de validade do login do administrador (padrão: 12 horas)
JWT_EXPIRA_EM=12h

# Origem permitida para o Frontend (GitHub Pages da loja e localhost para testes locais)
# Separe por vírgula se houver mais de um.
CORS_ORIGIN=https://engstrategy.github.io,http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:3000

# URL pública do Frontend (usada para exibir o link do cliente no terminal/seed)
FRONT_URL=https://engstrategy.github.io/nosso-gelado-fidelidade

# Caminho do banco de dados SQLite e backups
DB_PATH=./dados/fidelidade.db
BACKUP_DIR=./backups
BACKUP_MANTER=14

# Proteção contra clique duplo ao lançar selos (em segundos)
INTERVALO_SELO_SEGUNDOS=10

# Configuração de proxy (para identificar o IP real atrás do Tailscale Funnel)
TRUST_PROXY=loopback
